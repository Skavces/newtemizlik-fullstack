PORT=3001
NODE_ENV=development

# ── Veritabanı ──────────────────────────────────────────────
# Docker compose'da DB_HOST=db olarak override edilir
DB_HOST=localhost
DB_PORT=5432
DB_USER=newtemizlik
DB_PASS=guclu_bir_sifre_yaz

DB_NAME=newtemizlik

# Şema migration'larla kurulur ve güncellenir; uygulama açılışında bekleyen
# migration'lar otomatik çalışır (migrationsRun). Elle çalıştırmak için:
#   npm run migration:run

# ── JWT ─────────────────────────────────────────────────────
# ZORUNLU — en az 32 karakter rastgele string
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Admin ───────────────────────────────────────────────────
ADMIN_USERNAME=admin

# ZORUNLU — bcrypt hash, plain text şifre ASLA kullanılmaz
# Hash üretmek için: node -e "require('bcrypt').hash('SIFREN',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# ── CORS ────────────────────────────────────────────────────
# ZORUNLU — frontend domain (wildcard * kabul edilmez)
FRONTEND_URL=http://localhost:3000
# Opsiyonel — virgüllü açık origin listesi; doluysa aynen kullanılır (www
# türetme yapılmaz), boşsa FRONTEND_URL'den www'lu varyant türetilir.
# Örnek: CORS_ORIGINS=https://www.newtemizlik.com,https://newtemizlik.com
CORS_ORIGINS=

# ── Redis ───────────────────────────────────────────────────
# ZORUNLU — en az 32 karakter rastgele string
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_PASS=
# Docker compose'da redis://:${REDIS_PASS}@redis:6379 olarak override edilir
REDIS_URL=redis://:REDIS_PASS_BURAYA@localhost:6379

# ── Umami Analitik ──────────────────────────────────────────
# analytics.service.ts'in fiilen çağırdığı adres. Lokalde (kök docker-compose.yml
# ile ayağa kalkan Umami) http://localhost:3003, uygulama Docker içindeyken
# http://umami:3000 (aynı compose network'ünde servis adıyla).
UMAMI_URL=http://localhost:3003
# Umami kurulduktan sonra panel'den alınır
UMAMI_WEBSITE_ID=
# Umami admin şifresi (ilk girişte değiştir)
UMAMI_USER=admin
UMAMI_PASS=guclu_umami_sifresi
# Umami PostgreSQL şifresi
UMAMI_DB_PASS=guclu_umami_db_sifresi
# Umami uygulama gizli anahtarı — rastgele string, JWT_SECRET/APP_ENCRYPTION_KEY
# ile ASLA aynı değer olmasın (ikisi bağımsız sistemler; paylaşılan sır, birinin
# sızmasıyla ikisinin de düşmesi demektir)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UMAMI_APP_SECRET=

# ── Frontend Build ──────────────────────────────────────────
# Prodüksiyonda domain (örn: https://www.newtemizlik.com)
# Aynı domain'den servis ediliyorsa boş bırakılabilir
NEXT_PUBLIC_API_URL=
# Umami script URL'si (örn: https://umami.newtemizlik.com)
NEXT_PUBLIC_UMAMI_URL=
# Next.js sürecinden backend'e sunucu taraflı istekler (frontend/lib/api.js).
# Docker'da http://backend:3001/api olarak override edilir.
API_URL=http://localhost:3001/api

# ── Next.js Revalidation (Faz 3) ─────────────────────────────
# Boş bırakılırsa webhook hiç çağrılmaz, içerik yalnızca 3600sn'lik time-based
# revalidation ile güncellenir. Docker'da http://next:3000/revalidate.
REVALIDATE_URL=
# frontend/.env.example -> REVALIDATE_SECRET ile aynı değer olmalı
REVALIDATE_SECRET=

# ── Sentry (Hata İzleme) ────────────────────────────────────
# sentry.io üzerinde proje oluşturduktan sonra DSN'i buraya yapıştır
# Boş bırakılırsa Sentry devre dışı kalır
SENTRY_DSN=
APP_ENCRYPTION_KEY=  # openssl rand -hex 32 ile uret — TOTP secret sifrelemesi icin zorunlu
