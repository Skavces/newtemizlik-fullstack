# Kök docker-compose.yml için ortam değişkenleri (Faz 7: backend/frontend/db/
# redis/nginx). backend/.env.example'daki aynı isimli değişkenlerin buradaki
# değerleri backend servisinin environment bloğuna geçiriliyor — iki dosyayı
# elle senkron tutmak yerine tek doğruluk kaynağı burası.

# ── Veritabanı ──────────────────────────────────────────────
DB_PASS=DEGISTIR_guclu_bir_sifre

# ── JWT / Admin ─────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
# node -e "require('bcrypt').hash('SIFREN',12).then(console.log)"
# UYARI: bcrypt hash'i "$" karakteri içerir (ör. $2b$12$...) ve docker compose
# .env dosyalarında "$X" değişken interpolasyonu yapar — her "$" burada "$$"
# olarak escape edilmeli, yoksa hash sessizce bozulur (backend/.env'de ise
# doğrudan dotenv okunuyor, escape gerekmez).
ADMIN_PASSWORD_HASH=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# ── CORS / Frontend ─────────────────────────────────────────
FRONTEND_URL=https://www.newtemizlik.com
CORS_ORIGINS=
NEXT_PUBLIC_API_URL=
REVALIDATE_SECRET=

# ── Redis ───────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_PASS=

# ── Chatbot (LLM) ───────────────────────────────────────────
LLM_CHAT_KEYS=
LLM_DAILY_LIMIT=1000

# ── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=

# ── Umami Analitik ──────────────────────────────────────────
# Umami PostgreSQL şifresi
UMAMI_DB_PASS=DEGISTIR_guclu_umami_db_sifresi
# Umami uygulama gizli anahtarı — rastgele string, backend'in JWT_SECRET/
# APP_ENCRYPTION_KEY değerleriyle ASLA aynı olmasın (ikisi bağımsız sistemler;
# paylaşılan sır, birinin sızmasıyla ikisinin de düşmesi demektir)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UMAMI_APP_SECRET=

# İlk kurulumdan sonra Umami paneline admin/umami ile girip şifreyi bununla
# değiştir; sonra backend/.env'deki UMAMI_USER/UMAMI_PASS'i de eşitle.
UMAMI_USER=admin
UMAMI_PASS=DEGISTIR_guclu_umami_sifresi
UMAMI_WEBSITE_ID=
# Tarayıcının script.js'i çektiği adres — nginx /umami/ olarak proxy'lediği
# için aynı domain + /umami (örn. https://www.newtemizlik.com/umami)
NEXT_PUBLIC_UMAMI_URL=
