# Kök docker-compose.yml için ortam değişkenleri. Şu an sadece Umami stack'ini
# ayaklandırıyor (Faz 5); Faz 7'de backend/frontend/db/redis servisleri eklenince
# bu dosya da genişleyecek.

# ── Umami Analitik ──────────────────────────────────────────
# Umami PostgreSQL şifresi
UMAMI_DB_PASS=guclu_umami_db_sifresi
# Umami uygulama gizli anahtarı — rastgele string, backend'in JWT_SECRET/
# APP_ENCRYPTION_KEY değerleriyle ASLA aynı olmasın (ikisi bağımsız sistemler;
# paylaşılan sır, birinin sızmasıyla ikisinin de düşmesi demektir)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UMAMI_APP_SECRET=

# İlk kurulumdan sonra Umami paneline admin/umami ile girip şifreyi bununla
# değiştir; sonra backend/.env'deki UMAMI_USER/UMAMI_PASS'i de eşitle.
UMAMI_USER=admin
UMAMI_PASS=guclu_umami_sifresi
