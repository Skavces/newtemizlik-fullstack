# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example dokümantasyon amaçlı, gerçek sır içermez — commit edilmeli
# (backend/.gitignore'da bu zaten doğru; Next.js'in ürettiği bu dosyada
# geniş .env* deseni onu da yutuyordu — .env.example hiçbir zaman commit
# edilmemiş, Faz 5 doğrulamasında fark edildi)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
