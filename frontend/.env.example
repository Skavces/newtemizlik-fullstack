# Sunucu tarafı — backend'e Next.js sürecinden yapılan istekler (lib/api.js).
# Docker'da API_URL=http://backend:3001/api, lokal geliştirmede backend'i ayrı
# çalıştırıp burada override et.
API_URL=http://localhost:3001/api

# app/revalidate/route.js'i çağırırken backend'in (ve deploy sweep'inin)
# göndermesi gereken paylaşılan sır. Backend tarafındaki adı aynı:
# backend/.env.example -> REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Tarayıcı tarafı — Contact.jsx formu buradan POST atar.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Umami Analitik (Faz 5) ───────────────────────────────────
# Tarayıcı tarafı — ikisi de doluysa app/(site)/layout.tsx script'i yükler.
# Lokalde kök docker-compose.yml'in yayınladığı port: http://localhost:3003
# Üretimde ayrı bir subdomain kullanılır (örn. https://analytics.newtemizlik.com),
# host nginx'te kendi site config + sertifikasıyla. /umami subpath'i denendi ama
# terk edildi: ghcr.io'daki hazır Umami image'i BASE_PATH'i asset/route
# üretiminde uygulamıyor (her ikisi de prefix'siz kalıyor) ve Umami'nin kendi
# /api/* route'ları bizim backend'in /api/* namespace'iyle çakışıyordu. CSP
# script-src/connect-src'e subdomain ayrıca eklenmeli (nginx/security-headers.conf).
NEXT_PUBLIC_UMAMI_URL=http://localhost:3003
# Umami kurulup newtemizlik.com için website eklendikten sonra panelden alınır
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
