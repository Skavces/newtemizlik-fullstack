# renel-enerji/frontend/nginx.conf.template'den uyarlandı. Farkı: newtemizlik'in
# frontend'i Next.js App Router (SSR) olduğu için renel'deki prerender/bot-tespit
# ve SPA try_files mantığı yok — Next.js kendi sunucusunda (next:3000) render
# ediyor, nginx yalnızca TLS-sonrası reverse-proxy + security header + statik
# cache katmanı.

# Restore real client IP from Cloudflare
#
# BAKIM NOTU: Asagidaki CF IP araliklari (bu geo blogu + server icindeki
# set_real_ip_from listesi) elle gomulu. Yilda bir kez
# https://www.cloudflare.com/ips/ ile karsilastir; degisiklik varsa IKI blogu
# birlikte guncelle (son kontrol: 2026-09-29, renel-enerji'nin listesinden kopyalandi).
geo $cloudflare {
    default 0;
    103.21.244.0/22 1; 103.22.200.0/22 1; 103.31.4.0/22 1;
    104.16.0.0/13 1;  104.24.0.0/14 1;
    108.162.192.0/18 1; 131.0.72.0/22 1; 141.101.64.0/18 1;
    162.158.0.0/15 1; 172.64.0.0/13 1;  173.245.48.0/20 1;
    188.114.96.0/20 1; 190.93.240.0/20 1; 197.234.240.0/22 1;
    198.41.128.0/17 1;
    2400:cb00::/32 1; 2606:4700::/32 1; 2803:f800::/32 1;
    2405:b500::/32 1; 2405:8100::/32 1; 2a06:98c0::/29 1;
    2c0f:f248::/32 1;
}

server {
    listen 8080;
    server_name _;

    # Yukaridaki geo $cloudflare blogu ile ayni liste — birlikte guncellenmeli
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    # proxy_pass'te degisken kullanildiginda (DNS onbellek tuzagini onlemek
    # icin, asagida) Docker'in gomulu DNS'i resolver olarak gerekiyor
    resolver 127.0.0.11 valid=10s ipv6=off;

    server_tokens off;

    # TLS Cloudflare'da sonlaniyor; nginx duz 8080'de dinliyor, absolute
    # redirect "http://host:8080/..." sizdirmasin diye kapali
    absolute_redirect off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_comp_level 6;

    # Tek kaynak burasi — Next'in/backend'in kendi header'ları asagida
    # proxy_hide_header ile bastırılıyor (renel'deki "single source of truth" deseni)
    include /etc/nginx/snippets/security-headers.conf;

    location ^~ /umami/ {
        set $umami_upstream http://umami:3000;
        rewrite ^/umami/(.*)$ /$1 break;
        proxy_pass $umami_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect / /umami/;
        proxy_hide_header Content-Security-Policy;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        # Umami'nin kendi Next.js'i unsafe-inline/unsafe-eval istiyor — bu yüzden
        # ana site CSP'sinden ayrı, gevşetilmiş bir CSP
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;
    }

    location = /favicon.ico { return 204; access_log off; }
    location = /site.webmanifest { return 204; access_log off; }

    # helmet'in backend'de, Next'in kendi sunucusunda set ettiği header'lar —
    # nginx tek kaynak olduğu için çift header'ı önlemek üzere bastırılıyor
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;

    location ^~ /sitemap.xml {
        set $next_sitemap http://next:3000;
        proxy_pass $next_sitemap;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "public, max-age=3600";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ^~ /api/ {
        set $backend_api http://backend:3001;
        proxy_pass $backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100m;
    }

    location ^~ /uploads/ {
        set $backend_uploads http://backend:3001;
        proxy_pass $backend_uploads;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ^~ /_next/ {
        set $next_assets http://next:3000;
        proxy_pass $next_assets;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # public/ altındaki statik dosyalar — Next.js kendi sunucusundan servis eder
    location ~* \.(js|css|woff2|woff|ttf|ico|svg|jpg|jpeg|png|gif|webp|avif|mp4|webm)$ {
        set $next_static http://next:3000;
        proxy_pass $next_static;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        set $next_upstream http://next:3000;
        proxy_pass $next_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
